# Front-end (Vercel) — set in Vercel dashboard, then redeploy
# VITE_API_URL=https://literal-agentic-studio.onrender.com/api

# Back-end (Render) — allow browser requests from your Vercel app
# CORS_ALLOWED_ORIGINS=https://agent-test-orcin.vercel.app,http://localhost:5173
# SECRET_KEY=change-me-in-production
# DEBUG=false

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_ITER=20

# Tool approval
AUTO_APPROVE_TOOLS=false
APPROVAL_TIMEOUT_SEC=300

# Tools
SERPER_API_KEY=
GITHUB_TOKEN=

# Email (IMAP)
EMAIL_USERNAME=
EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
